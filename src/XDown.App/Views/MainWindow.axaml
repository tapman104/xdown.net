<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XDown.App.ViewModels"
        xmlns:conv="using:XDown.App.Converters"
        x:Class="XDown.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        Title="{Binding WindowTitle}" Width="520" Height="420"
        FontFamily="Segoe UI"
        CanResize="False">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,16,0,16">

    <!-- URL input -->
    <StackPanel Margin="20,0">
      <TextBlock Text="URL"
                 Classes="label"
                 FontSize="12"
                 Foreground="#B3B3B3"
                 Margin="0,0,0,4"/>
      <TextBox Text="{Binding Url}"
               Watermark="https://example.com/file.zip"
               IsEnabled="{Binding !IsDownloading}"
               Height="36"
               CornerRadius="6"/>
    </StackPanel>

    <!-- Output path -->
    <StackPanel Margin="20,8,20,0">
      <TextBlock Text="Save as"
                 Classes="label"
                 FontSize="12"
                 Foreground="#B3B3B3"
                 Margin="0,0,0,4"/>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 Text="{Binding OutputPath}"
                 IsEnabled="{Binding !IsDownloading}"
                 Height="36"
                 CornerRadius="6"/>
        <Button Grid.Column="1"
                Content="Browse"
                Click="OnBrowseOutputPathClick"
                Margin="8,0,0,0"
                IsEnabled="{Binding !IsDownloading}"
                Height="36"
                CornerRadius="6"
                BorderBrush="#3A3A3A"
                BorderThickness="1"/>
      </Grid>
    </StackPanel>

    <!-- Progress bar -->
    <ProgressBar Minimum="0" Maximum="100"
                 Margin="20,8,20,0"
                 Height="6"
                 CornerRadius="3"
                 Foreground="#2F7DFF"
                 Value="{Binding ProgressPercent}"
                 IsIndeterminate="{Binding ProgressPercent,
                     Converter={x:Static conv:NegativeConverter.Instance}}"/>

    <!-- Status row -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,8,20,0">
      <TextBlock Text="{Binding StatusText}"
                 Grid.Column="0"
                 FontSize="12"
                 Foreground="#A6A6A6"/>
      <TextBlock Text="{Binding SpeedText}"
                 Grid.Column="1"
                 Margin="12,0,0,0"
                 FontSize="12"
                 Foreground="#A6A6A6"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"/>
      <TextBlock Text="{Binding EtaText}"
                 Grid.Column="2"
                 Margin="12,0,0,0"
                 FontSize="12"
                 Foreground="#A6A6A6"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"/>
    </Grid>

    <Grid IsVisible="{Binding ShowOpenFolder}" Margin="20,8,20,0">
      <Button Content="Open folder"
              Command="{Binding OpenFolderCommand}"
              Classes="hyperlink"
              HorizontalAlignment="Left"
              Padding="0"
              MinWidth="0"
              Background="Transparent"
              BorderThickness="0"
              Margin="0,2,0,0"/>
    </Grid>

    <!-- Advanced options -->
    <Expander Header="Advanced" HorizontalAlignment="Stretch" Margin="20,8,20,0">
      <Border Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="0,4,0,0">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
          <CheckBox Grid.Row="0" Grid.Column="0"
                    Content="Resume"
                    IsChecked="{Binding ResumeEnabled}"
                    IsEnabled="{Binding !IsDownloading}"
                    Margin="0,0,10,8"/>

          <TextBlock Grid.Row="1" Grid.Column="0"
                     VerticalAlignment="Center"
                     Text="Segments"
                     FontSize="12"
                     Foreground="#B3B3B3"
                     Margin="0,0,10,0"/>
          <NumericUpDown Grid.Row="1" Grid.Column="1"
                         Minimum="1"
                         Maximum="16"
                         FormatString="0"
                         Value="{Binding SegmentCount}"
                         IsEnabled="{Binding !IsDownloading}"
                         HorizontalAlignment="Left"
                         Width="110"/>
        </Grid>
      </Border>
    </Expander>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="20,8,20,0">
          <Button Content="{Binding DownloadButtonText}"
                  Command="{Binding StartCommand}"
                  Height="38"
                  MinWidth="120"
                  CornerRadius="8"
                  Background="#2F7DFF"
                  Foreground="White"
                  BorderThickness="0"/>
          <Button Content="Cancel"
                  Command="{Binding CancelCommand}"
                  IsVisible="{Binding IsDownloading}"
                  Height="38"
                  CornerRadius="8"/>
        </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
