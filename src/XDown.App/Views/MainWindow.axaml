<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:XDown.App.ViewModels"
        xmlns:conv="using:XDown.App.Converters"
        x:Class="XDown.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
          Title="{ReflectionBinding WindowTitle}" Width="520" Height="400"
        CanResize="False">

        <StackPanel Margin="24" Spacing="12">

    <!-- URL input -->
    <TextBlock Text="URL" Classes="label"/>
    <TextBox Text="{Binding Url}"
             Watermark="https://example.com/file.zip"
             IsEnabled="{Binding !IsDownloading}"/>

    <!-- Output path -->
    <TextBlock Text="Save as" Classes="label"/>
    <Grid ColumnDefinitions="*,Auto">
      <TextBox Grid.Column="0"
               Text="{Binding OutputPath}"
               IsEnabled="{Binding !IsDownloading}"/>
      <Button Grid.Column="1"
              Content="Browse"
              Click="OnBrowseOutputPathClick"
              Margin="8,0,0,0"
              IsEnabled="{Binding !IsDownloading}"/>
    </Grid>

    <!-- Progress bar -->
    <ProgressBar Minimum="0" Maximum="100"
                 Value="{Binding ProgressPercent}"
                 IsIndeterminate="{Binding ProgressPercent, 
                     Converter={x:Static conv:NegativeConverter.Instance}}"/>

    <!-- Status row -->
    <Grid ColumnDefinitions="*,Auto,Auto">
      <TextBlock Text="{Binding StatusText}" Grid.Column="0"/>
      <TextBlock Text="{Binding SpeedText}"
                 Grid.Column="1"
                 Margin="12,0,0,0"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"/>
      <TextBlock Text="{Binding EtaText}"
                 Grid.Column="2"
                 Margin="12,0,0,0"
                 HorizontalAlignment="Right"
                 TextAlignment="Right"/>
    </Grid>

          <Button Content="Open folder"
              Command="{Binding OpenFolderCommand}"
              Classes="hyperlink"
              IsVisible="{Binding ShowOpenFolder}"
              HorizontalAlignment="Left"
              Padding="0"
              MinWidth="0"
              Background="Transparent"
              BorderThickness="0"/>

    <!-- Advanced options -->
    <Expander Header="Advanced" HorizontalAlignment="Left" Width="480">
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
        <CheckBox Grid.Row="0" Grid.Column="0"
                  Content="Resume"
                  IsChecked="{Binding ResumeEnabled}"
                  IsEnabled="{Binding !IsDownloading}"
                  Margin="0,0,10,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Segments"
                   Margin="0,0,10,0"/>
        <NumericUpDown Grid.Row="1" Grid.Column="1"
                       Minimum="1"
                       Maximum="16"
                       Value="{Binding SegmentCount}"
                       IsEnabled="{Binding !IsDownloading}"
                       HorizontalAlignment="Left"
                       Width="110"/>
      </Grid>
    </Expander>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button Content="{Binding DownloadButtonText}"
            Command="{Binding StartCommand}"/>
          <Button Content="Cancel"
            Command="{Binding CancelCommand}"
            IsVisible="{Binding IsDownloading}"/>
        </StackPanel>

  </StackPanel>
</Window>
